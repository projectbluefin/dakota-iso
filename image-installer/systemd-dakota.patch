+static bool dakota_cryptenroll(void) {
+        return secure_getenv("DAKOTA_CRYPTENROLL") != NULL;
+}
+
+static int dakota_open_trusted(int dir_fd, const char *path, bool directory) {
+        _cleanup_close_ int fd = xopenat(dir_fd, path,
+                                        O_RDONLY|O_NOFOLLOW|O_NONBLOCK|(directory ? O_DIRECTORY : 0));
+        struct stat st;
+        if (fd < 0)
+                return fd;
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (!(directory ? S_ISDIR(st.st_mode) : S_ISREG(st.st_mode)) || st.st_uid != 0 || (st.st_mode & 0022))
+                return -EPERM;
+        return TAKE_FD(fd);
+}
+
+static int dakota_verify_receipt(int dir_fd, const char *name, const char *expected) {
+        _cleanup_close_ int fd = dakota_open_trusted(dir_fd, name, /* directory= */ false);
+        if (fd < 0)
+                return fd;
+        char buf[PATH_MAX + DECIMAL_STR_MAX(uint64_t) + 3];
+        size_t len = strlen(expected);
+        if (len >= sizeof(buf))
+                return -ENAMETOOLONG;
+        ssize_t n = loop_read(fd, buf, len + 1, /* do_poll= */ false);
+        if (n < 0)
+                return (int) n;
+        return (size_t) n == len && memcmp(buf, expected, len) == 0 ? 0 : -ESTALE;
+}
+
+static int dakota_open_recovery(
+                const char *node, int mode, char **ret_node, int *ret_runtime_fd, LoopDevice **ret_loop) {
+
+        _cleanup_close_ int run_fd = -EBADF, runtime_fd = -EBADF, fd = -EBADF;
+        _cleanup_(sd_device_unrefp) sd_device *partition = NULL;
+        _cleanup_(loop_device_unrefp) LoopDevice *loop = NULL;
+        _cleanup_free_ char *expected = NULL;
+        sd_device *disk;
+        const char *canonical, *whole, *partnum;
+        uint64_t seq;
+        int r;
+
+        if (!node || !startswith(node, "/dev/disk/by-diskseq/"))
+                return -EINVAL;
+        run_fd = dakota_open_trusted(AT_FDCWD, "/run", /* directory= */ true);
+        if (run_fd < 0)
+                return run_fd;
+        runtime_fd = dakota_open_trusted(run_fd, "dakota-live", /* directory= */ true);
+        if (runtime_fd < 0)
+                return runtime_fd;
+        if (flock(runtime_fd, LOCK_EX|LOCK_NB) < 0)
+                return errno == EWOULDBLOCK ? -EBUSY : -errno;
+
+        r = block_device_new_from_path(node, /* flags= */ 0, &partition);
+        if (r < 0)
+                return r;
+        r = sd_device_get_sysattr_value(partition, "partition", &partnum);
+        if (r < 0)
+                return r;
+        r = sd_device_get_devname(partition, &canonical);
+        if (r < 0)
+                return r;
+        if (asprintf(&expected, "%s\n", canonical) < 0)
+                return -ENOMEM;
+        r = dakota_verify_receipt(runtime_fd, "encrypted-root", expected);
+        if (r < 0)
+                return r;
+        fd = sd_device_open(partition, mode|O_EXCL|O_CLOEXEC|O_NONBLOCK|O_NOCTTY);
+        if (fd < 0)
+                return fd;
+        r = fd_get_diskseq(fd, &seq);
+        if (r < 0)
+                return r;
+        expected = mfree(expected);
+        if (asprintf(&expected, "/dev/disk/by-diskseq/%" PRIu64 "-part%s", seq, partnum) < 0)
+                return -ENOMEM;
+        if (!streq(node, expected))
+                return -ESTALE;
+        r = block_device_get_whole_disk(partition, &disk);
+        if (r < 0)
+                return r;
+        r = sd_device_get_devname(disk, &whole);
+        if (r < 0)
+                return r;
+        expected = mfree(expected);
+        if (asprintf(&expected, "%s\n%" PRIu64 "\n", whole, seq) < 0)
+                return -ENOMEM;
+        r = dakota_verify_receipt(runtime_fd, "installed-disk", expected);
+        if (r < 0)
+                return r;
+
+        /* crypt_init accepts only paths. The loop holds the checked block file, not a reopened dev_t. */
+        r = loop_device_make(fd, mode, 0, 0, 0, LOOP_DEVICE_PIN_BACKING_FD, LOCK_EX, &loop);
+        if (r < 0)
+                return r;
+        r = strdup_to(ret_node, loop->node);
+        if (r < 0)
+                return r;
+        *ret_runtime_fd = TAKE_FD(runtime_fd);
+        *ret_loop = TAKE_PTR(loop);
+        return 0;
+}
