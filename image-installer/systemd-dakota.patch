+#define DAKOTA_RUN_DIR "dakota-live"
+#define DAKOTA_DEFINITIONS "/run/" DAKOTA_RUN_DIR "/repart.d"
+#define DAKOTA_RECEIPT "installed-disk"
+
+static int dakota_open_trusted_dir(int parent_fd, const char *name) {
+        _cleanup_close_ int fd = xopenat(parent_fd, name, O_RDONLY|O_DIRECTORY|O_NOFOLLOW);
+        struct stat st;
+        if (fd < 0)
+                return fd;
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (st.st_uid != 0 || (st.st_mode & 0022))
+                return -EPERM;
+        return TAKE_FD(fd);
+}
+
+static int dakota_open_runtime(void) {
+        if (geteuid() != 0)
+                return -EPERM;
+
+        _cleanup_close_ int run_fd = dakota_open_trusted_dir(AT_FDCWD, "/run");
+        if (run_fd < 0)
+                return run_fd;
+        _cleanup_close_ int runtime_fd = dakota_open_trusted_dir(run_fd, DAKOTA_RUN_DIR);
+        if (runtime_fd < 0)
+                return runtime_fd;
+        _cleanup_close_ int definitions_fd = dakota_open_trusted_dir(runtime_fd, "repart.d");
+        if (definitions_fd < 0)
+                return definitions_fd;
+
+        _cleanup_closedir_ DIR *definitions = take_fdopendir(&definitions_fd);
+        if (!definitions)
+                return -errno;
+        FOREACH_DIRENT_ALL(de, definitions, return -errno) {
+                struct stat st;
+                if (dot_or_dot_dot(de->d_name))
+                        continue;
+                if (fstatat(dirfd(definitions), de->d_name, &st, AT_SYMLINK_NOFOLLOW) < 0)
+                        return -errno;
+                if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 0022))
+                        return -EPERM;
+        }
+
+        return TAKE_FD(runtime_fd);
+}
+
+static int dakota_open_target(Context *context, const char *node, dev_t *ret_root, dev_t *ret_medium) {
+        _cleanup_(sd_device_unrefp) sd_device *device = NULL;
+        _cleanup_close_ int fd = -EBADF;
+        dev_t root, medium, origin;
+        const char *devpath, *canonical;
+        struct stat st;
+        int r;
+
+        r = find_backing_devno("/sysroot", /* root= */ NULL, &root);
+        if (r < 0)
+                return log_error_errno(r, "Cannot identify the running Dakota medium: %m");
+        r = block_get_originating(root, &origin, /* recursive= */ true);
+        if (r >= 0)
+                root = origin;
+        else if (r != -ENOENT)
+                return r;
+        r = block_get_whole_disk(root, &medium);
+        if (r < 0)
+                return r;
+
+        if (!path_startswith(node, "/dev"))
+                return -ENOTBLK;
+        r = block_device_new_from_path(node, /* flags= */ 0, &device);
+        if (r < 0)
+                return r;
+        r = block_device_is_whole_disk(device);
+        if (r <= 0)
+                return r < 0 ? r : -ENOTBLK;
+        r = sd_device_get_devpath(device, &devpath);
+        if (r < 0)
+                return r;
+        if (path_startswith(devpath, "/devices/virtual"))
+                return -ENOTBLK; /* Stacked/loop devices are not independent raw disks. */
+        r = sd_device_get_devname(device, &canonical);
+        if (r < 0)
+                return r;
+
+        fd = sd_device_open(device, context_open_mode(context)|O_EXCL|O_CLOEXEC|O_NONBLOCK|O_NOCTTY);
+        if (fd < 0)
+                return fd; /* Including mounted partitions or other kernel holders. */
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (st.st_rdev == medium)
+                return -EPERM;
+        r = blockdev_partscan_enabled_fd(fd);
+        if (r <= 0)
+                return r < 0 ? r : -ENOTBLK;
+        if (flock(fd, (context->dry_run ? LOCK_SH : LOCK_EX)|LOCK_NB) < 0)
+                return errno == EWOULDBLOCK ? -EBUSY : -errno;
+
+        r = strdup_to(&context->node, canonical);
+        if (r < 0)
+                return r;
+        context->backing_fd = TAKE_FD(fd);
+        *ret_root = root;
+        *ret_medium = medium;
+        return 0;
+}
+
+static int dakota_target_is_blank(int fd) {
+#if HAVE_BLKID
+        _cleanup_(blkid_free_probep) blkid_probe probe = NULL;
+        int r;
+
+        r = dlopen_libblkid(LOG_ERR);
+        if (r < 0)
+                return r;
+        probe = sym_blkid_new_probe();
+        if (!probe)
+                return log_oom();
+
+        errno = 0;
+        if (sym_blkid_probe_set_device(probe, fd, /* off= */ 0, /* size= */ 0) < 0 ||
+            sym_blkid_probe_enable_superblocks(probe, true) < 0 ||
+            sym_blkid_probe_set_superblocks_flags(probe, BLKID_SUBLKS_MAGIC|BLKID_SUBLKS_BADCSUM) < 0 ||
+            sym_blkid_probe_enable_partitions(probe, true) < 0 ||
+            sym_blkid_probe_set_partitions_flags(probe, BLKID_PARTS_MAGIC) < 0)
+                return errno_or_else(EIO);
+
+        /* shortcut: unrecognized data is not detectable here; require explicit erase if full-device zero verification is needed. */
+        errno = 0;
+        r = sym_blkid_do_probe(probe);
+        return r < 0 ? errno_or_else(EIO) : r > 0;
+#else
+        return -EOPNOTSUPP;
+#endif
+}
+
+static int dakota_verify_sources(Context *context, dev_t root, dev_t medium) {
+        unsigned n_esp = 0;
+
+        if (context->n_partitions != 2)
+                return -EINVAL;
+
+        LIST_FOREACH(partitions, p, context->partitions) {
+                struct stat st;
+                dev_t disk;
+                bool esp = p->type.designator == PARTITION_ESP;
+
+                if (p->copy_blocks_fd < 0 || p->dropped || partition_defer(context, p))
+                        return -EINVAL;
+                if (fstat(p->copy_blocks_fd, &st) < 0)
+                        return -errno;
+                if (!S_ISBLK(st.st_mode))
+                        return -ENOTBLK;
+                int r = block_get_whole_disk(st.st_rdev, &disk);
+                if (r < 0)
+                        return r;
+                if (r == 0 || disk != medium || esp == (st.st_rdev == root))
+                        return -EPERM;
+                n_esp += esp;
+        }
+
+        return n_esp == 1 ? 0 : -EINVAL;
+}
