+                        return log_error_errno(r, "Cannot publish the Dakota install receipt: %m");
+                receipt_tmp = mfree(receipt_tmp);
+        }
+
         context_disarm_auto_removal(context);
+        if (dakota_raw)
+                context = context_free(context); /* Release the disk claim before post-install can start. */

         return sd_varlink_reply(link, /* parameters= */ NULL);
 }
