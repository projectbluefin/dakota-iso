[Unit]
Description=Dakota live: Disk Encryption Enrollment
DefaultDependencies=no
Wants=modprobe@dm_mod.service
After=modprobe@dm_mod.service systemd-tpm2-setup-early.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Environment=DAKOTA_CRYPTENROLL=1
ExecStart=/usr/libexec/dakota-sysinstall/systemd-cryptenroll
