[Unit]
Description=Dakota live: System Install Tool socket (io.systemd.SysInstall)
ConditionKernelCommandLine=dakota.live.installer=gnome-setup
DefaultDependencies=no
Before=sockets.target
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/systemd/io.systemd.SysInstall
Symlinks=/run/varlink/registry/io.systemd.SysInstall
FileDescriptorName=varlink
SocketMode=0666
Accept=yes
MaxConnectionsPerSource=16

[Install]
WantedBy=sockets.target
