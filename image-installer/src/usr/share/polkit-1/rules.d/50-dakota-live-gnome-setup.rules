// Dakota live session (dakota.live.installer=gnome-setup): allow liveuser to install without password prompts.
polkit.addRule(function(action, subject) {
    if (subject.user != "liveuser" || !subject.active || !subject.local)
        return undefined;

    if (action.id == "io.systemd.sysinstall.Run" ||
        action.id == "io.systemd.sysinstall.ListCandidateDevices" ||
        action.id == "io.systemd.cryptenroll.enroll" ||
        action.id == "io.systemd.cryptenroll.list-slots" ||
        action.id == "org.freedesktop.locale1.set-locale" ||
        action.id == "org.freedesktop.locale1.set-keyboard")
        return polkit.Result.YES;

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        /^dakota-sysinstall-post@[^/]+\.service$/.test(action.lookup("unit") || ""))
        return polkit.Result.YES;

    return undefined;
});
