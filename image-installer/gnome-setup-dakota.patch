+fn device_name(node: &str) -> anyhow::Result<&str> {
+    let name = node.strip_prefix("/dev/").ok_or_else(|| anyhow!("Invalid device path"))?;
+    ensure!(
+        !name.is_empty() && !matches!(name, "." | "..") && !name.contains(['/', '\n']),
+        "Invalid device name"
+    );
+    Ok(name)
+}
+
+/// Match the post-install receipt, but send CryptEnroll the sequence-qualified partition.
+pub(super) fn installed_luks_partition() -> anyhow::Result<String> {
+    let installed_disk = INSTALLED_DISK.lock().unwrap();
+    let (disk, diskseq) = installed_disk.as_ref().ok_or_else(|| anyhow!("No installed disk"))?;
+    let sysfs = Path::new("/sys/class/block").join(device_name(disk)?);
+    let receipt = fs::read_to_string("/run/dakota-live/encrypted-root")?;
+    let node = receipt.strip_suffix('\n').ok_or_else(|| anyhow!("Invalid encrypted-root receipt"))?;
+    let part = fs::read_to_string(sysfs.join(device_name(node)?).join("partition"))?
+        .trim()
+        .parse::<u32>()?;
+    ensure!(part > 0, "Invalid installed partition number");
+
+    let link = format!("{DISKSEQ_DIR}/{diskseq}-part{part}");
+    ensure!(fs::canonicalize(&link)?.as_os_str() == OsStr::new(node), "LUKS partition does not match the post-install receipt");
+    ensure!(fs::read_to_string(sysfs.join("diskseq"))?.trim().parse::<i64>()? == *diskseq, "Installed disk changed");
+    Ok(link)
+}
+
+fn post_install_instance(node: &str) -> anyhow::Result<String> {
+    let unit = POST_INSTALL_UNIT
+        .get()
+        .and_then(Option::as_deref)
+        .ok_or_else(|| anyhow!("Missing post-install service configuration"))?;
+    super::systemd_manager::template_instance(unit, node)
+}
+
+pub async fn publish_installed_boot() -> anyhow::Result<()> {
+    if crate::is_demo() {
+        return Ok(());
+    }
+    let instance = {
+        let installed_disk = INSTALLED_DISK.lock().unwrap();
+        let (node, _) = installed_disk.as_ref().ok_or_else(|| anyhow!("No installed disk"))?;
+        post_install_instance(node)?
+    };
+    super::systemd_manager::start_unit_and_wait(&instance).await
+}

